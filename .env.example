# RetailFlow AI - Environment Configuration
PORT=8000
HOST=0.0.0.0

# Optional: Google Gemini Free-Tier API Key
# If omitted or empty, the app runs completely offline using its built-in zero-cost heuristic NLP engine.
GEMINI_API_KEY=

# Store Customization Defaults
STORE_NAME=Krishna Stores & Provisions
STORE_HOURS=7:00 AM - 10:00 PM Daily
STORE_PHONE=+91 98765 43210
STORE_ADDRESS=Main Bazaar Road, Opp. Bus Stand

# Database Path (Defaults to local sqlite retail.db)
RETAIL_DB_PATH=retail.db
